# Copiar a .env.local y llenar con los valores reales (nunca versionar .env.local).
# Los valores locales de SUPABASE_URL / *_KEY / JWT_SECRET los imprime `yarn db:start`.

# --- Supabase (backend local) ---
# URL del gateway local (Kong). Ver supabase/config.toml para el puerto (spec.md §4).
SUPABASE_URL=http://localhost:54321

# Llave pública (anon). Respeta RLS. Se usa desde el cliente (frontend).
SUPABASE_ANON_KEY=

# Llave de rol de servicio. Bypassa RLS.
# NUNCA exponer al cliente Nuxt — solo Edge Functions / procesos de servidor.
SUPABASE_SERVICE_ROLE_KEY=

# Secreto para verificación propia de JWT (si algún proceso de servidor lo requiere).
SUPABASE_JWT_SECRET=

# --- Notificaciones (módulo futuro, no consumido todavía) ---
# Correo (Resend/SendGrid — decisión final pendiente del spec de Notificaciones)
RESEND_API_KEY=

# WhatsApp/SMS (Twilio o WhatsApp Business API — decisión final pendiente)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
