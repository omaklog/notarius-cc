# Copiar a .env y llenar con los valores reales (nunca versionar .env).
# En la VM de Proxmox, el script `./scripts/deploy-vm.sh` genera/actualiza las llaves automáticamente.

# --- Puerto del servidor web (Notarius Frontend/SSR) ---
# Usamos 3010 por defecto para no chocar con otro proyecto que ya ocupe el 3000
PORT=3010

# --- Supabase (backend local o en VM) ---
# IMPORTANTE para VM en Proxmox (Tailscale / VPN / Cloudflare Tunnel):
# Debe ser la URL accesible desde el navegador de los usuarios (Kong escucha en 54331):
#   - Tailscale / VPN: http://<IP_O_MAGICDNS_TAILSCALE>:54331
#   - Cloudflare Tunnel: https://api.tudominio.com
#   - Desarrollo local: http://localhost:54331
SUPABASE_URL=http://localhost:54331

# Llave pública (anon). Respeta RLS. Se usa desde el cliente (frontend).
SUPABASE_ANON_KEY=

# Llave de rol de servicio. Bypassa RLS.
# NUNCA exponer al cliente Nuxt — solo Edge Functions / procesos de servidor.
SUPABASE_SERVICE_ROLE_KEY=

# Secreto para verificación propia de JWT.
SUPABASE_JWT_SECRET=

# --- Cookies de Sesión (Auth) ---
# En false si se accede por HTTP (ej. IP de Tailscale/VPN http://100.x.y.z:3010).
# En true si se accede por HTTPS (ej. Tailscale Serve HTTPS o Cloudflare Tunnel).
SUPABASE_COOKIE_SECURE=false

# Contraseña inicial por defecto al dar de alta usuarios desde Administración (sin envío de correo)
DEFAULT_USER_PASSWORD=Password123!

# --- Reconocimiento OCR de Identificaciones (Gemini Vision API) ---
# Opcional: si no se define, el asistente OCR puede operar en modo demostración/prueba.
GEMINI_API_KEY=

# --- Notificaciones (proveedores externos opcionales) ---
RESEND_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
